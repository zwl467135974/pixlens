{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixLens",
  "version": "1.1.2",
  "identifier": "com.pixlens.app",
  "mainBinaryName": "pixlens",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PixLens 图镜",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../target/release/pixlens_thumb_cpp.dll": "pixlens_thumb_cpp.dll",
      "../target/release/pixlens_psd.dll": "pixlens_psd.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      { "ext": ["psd"], "name": "PSD 图像", "description": "Photoshop 文档", "role": "Viewer" },
      { "ext": ["psb"], "name": "PSB 图像", "description": "Photoshop 大型文档", "role": "Viewer" },
      { "ext": ["tif", "tiff"], "name": "TIFF 图像", "description": "TIFF 图像（含多页）", "role": "Viewer" },
      { "ext": ["jpg", "jpeg"], "name": "JPEG 图像", "description": "JPEG 图像", "role": "Viewer" },
      { "ext": ["png"], "name": "PNG 图像", "description": "PNG 图像", "role": "Viewer" },
      { "ext": ["gif"], "name": "GIF 图像", "description": "GIF 动画", "role": "Viewer" },
      { "ext": ["webp"], "name": "WebP 图像", "description": "WebP 图像", "role": "Viewer" },
      { "ext": ["bmp"], "name": "BMP 图像", "description": "位图", "role": "Viewer" },
      { "ext": ["avif"], "name": "AVIF 图像", "description": "AVIF 图像", "role": "Viewer" },
      { "ext": ["svg"], "name": "SVG 图像", "description": "SVG 矢量图", "role": "Viewer" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  }
}
